# The public DNS name that points to this VPS. Do not include https:// or a path.
APP_DOMAIN=care.example.com

# Use unique, long values. Generate them with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=nurture
POSTGRES_USER=nurture
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Leave these blank if Google sign-in is not enabled. If enabled, register:
# https://care.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
