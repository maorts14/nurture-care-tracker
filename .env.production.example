# The public DNS name that points to this VPS. Do not include https:// or a path.
APP_DOMAIN=care.example.com

# Versioned private images published to GitHub Container Registry.
FEEDME_API_IMAGE=ghcr.io/maorts14/feedme-api:1.0.0
FEEDME_WEB_IMAGE=ghcr.io/maorts14/feedme-web:1.0.0
FEEDME_DB_IMAGE=ghcr.io/maorts14/feedme-db:1.0.0

# Use unique, long values. Generate them with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=nurture
POSTGRES_USER=nurture
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Leave these blank if Google sign-in is not enabled. If enabled, register:
# https://care.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
